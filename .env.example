# Server-only API-Football key. Never prefix this with NEXT_PUBLIC_.
API_FOOTBALL_KEY=replace_with_your_api_key

# Supabase project details. These are safe browser-facing project credentials;
# database access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
